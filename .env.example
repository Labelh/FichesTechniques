# ============================================================
# Variables d'environnement nécessaires au BUILD de l'app
# Copier ce fichier en .env et remplir les valeurs réelles.
# NE JAMAIS committer .env dans Git.
# ============================================================

# ── Firebase (backend principal — Firestore + Storage) ─────
# Console Firebase → Paramètres projet → Vos applications → SDK Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optionnel (Analytics)
VITE_FIREBASE_MEASUREMENT_ID=

# ── ImgBB (hébergement d'images — remplacé en Phase 2) ─────
# https://api.imgbb.com/ → clé API gratuite
VITE_IMGBB_API_KEY=

# ── Supabase gstock (lecture seule — sera remplacé en Phase 2) ─
# Supabase dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
