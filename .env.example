# ============================================================
# Variables d'environnement nécessaires au BUILD de l'app
# Copier ce fichier en .env et remplir les valeurs réelles.
# NE JAMAIS committer .env dans Git.
# ============================================================

# ── Firebase (backend principal — Firestore + Storage) ─────
# Console Firebase → Paramètres projet → Vos applications → SDK Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optionnel (Analytics)
VITE_FIREBASE_MEASUREMENT_ID=

# ── Référentiel Néode (hébergement d'images — VPS Shadow) ──
# Store adressé par référence article. Remplace ImgBB.
# Origine du store (sans slash final)
VITE_REFERENTIEL_ORIGIN=https://shadow.ajust82.fr
# Jeton d'upload (en-tête X-Upload-Token) — fourni par Néode/Cédric
VITE_REFERENTIEL_UPLOAD_TOKEN=

# ── Supabase gstock (lecture seule — sera remplacé en Phase 2) ─
# Supabase dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
