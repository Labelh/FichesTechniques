# app-ft-api — variables d'environnement
PORT=3000
CACHE_FILE=/data/ft_cache.json
# Clé service Firebase (Admin SDK). En prod : montée en volume sur /app/serviceAccount.json.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# Secret SSO partagé avec neode-app/Atelier (vérif du Bearer token audience "atelier").
SSO_TOKEN_SECRET=change-me
SSO_AUDIENCE=atelier
REQUIRE_AUTH=true
# Token du POST /ft-api/refresh (rebuild manuel du cache après publication d'une fiche).
REFRESH_TOKEN=change-me
# Durée de validité du cache avant rebuild paresseux (ms). 6h par défaut (quota Spark).
CACHE_TTL_MS=21600000
